NEXT_PUBLIC_API_BASE=/backend
API_ORIGIN=http://127.0.0.1:8701
# Server-only key for the signed-in product assistant. Keep this out of NEXT_PUBLIC_*.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4.1-mini
NEXT_PUBLIC_AUTH_PROVIDER=jwt
# For Clerk mode use the same tenant as FastAPI.
# NEXT_PUBLIC_AUTH_PROVIDER=clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_JWT_TEMPLATE=
# Set only when the deployment edge overwrites this header with one verified client IP.
# TRUSTED_CLIENT_IP_HEADER=
