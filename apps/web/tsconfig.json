{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-admin-verified/types/**/*.ts",
    ".next-admin/types/**/*.ts",
    ".next-angel-connect/types/**/*.ts",
    ".next-angel-panels/types/**/*.ts",
    ".next-angel-signed-screen/types/**/*.ts",
    ".next-chart-bar-readout/types/**/*.ts",
    ".next-chart-daily-readout/types/**/*.ts",
    ".next-company-news/types/**/*.ts",
    ".next-company-search/types/**/*.ts",
    ".next-datadaily-nav/types/**/*.ts",
    ".next-eodhd-recovery/types/**/*.ts",
    ".next-free-news-final/types/**/*.ts",
    ".next-free-news/types/**/*.ts",
    ".next-free-sentiment-final/types/**/*.ts",
    ".next-free-sentiment/types/**/*.ts",
    ".next-full-table-columns/types/**/*.ts",
    ".next-home-news/types/**/*.ts",
    ".next-indicator-visibility/types/**/*.ts",
    ".next-job-market-status/types/**/*.ts",
    ".next-job-run-history/types/**/*.ts",
    ".next-latest-seven/types/**/*.ts",
    ".next-live-screen/types/**/*.ts",
    ".next-news-attention-final/types/**/*.ts",
    ".next-news-attention/types/**/*.ts",
    ".next-news-editorial/types/**/*.ts",
    ".next-popup/types/**/*.ts",
    ".next-queue-stock-coverage/types/**/*.ts",
    ".next-rq-navigation/types/**/*.ts",
    ".next-screen-result-settings/types/**/*.ts",
    ".next-screener-feed/types/**/*.ts",
    ".next-sector-align/types/**/*.ts",
    ".next-stacked-tables/types/**/*.ts",
    ".next-stock-news/types/**/*.ts",
    ".next-stock-ticks/types/**/*.ts",
    ".next-tab-audit/types/**/*.ts",
    ".next-watch-fields/types/**/*.ts",
    ".next-workspace-tables/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
  ],
  "exclude": [
    "node_modules"
  ]
}
