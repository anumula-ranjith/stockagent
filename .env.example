# Copy to .env and fill in. Never commit .env.

# ---- Operational database ----
# PostgreSQL is the warehouse for the API, ingestion, scoring and backtests.
DATABASE_URL=postgresql://stockagents:replace-with-your-password@127.0.0.1:5432/stockagents

# ---- Authentication ----
# Generate independent random secrets of at least 32 bytes.
AUTH_PROVIDER=jwt
JWT_SECRET=
BOOTSTRAP_SIGNUP_TOKEN=
# Account verification and password recovery email.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL=
EMAIL_PASSWORD=
FRONTEND_URL=http://localhost:3001
# Local HTTP session cookies.
AUTH_COOKIE_SECURE=false
# REQUIRE_MARKET_DATA_AUTH=true
# PUBLIC_API_ORIGIN=https://api.example.com
# Optional shared rate limits across API processes.
# AUTH_RATE_LIMIT_STORAGE_URL=redis://127.0.0.1:6379/1
# Required in Clerk mode. Use your own instance and frontend origins.
# CLERK_ISSUER=
# CLERK_JWKS_URL=
# CLERK_AUTHORIZED_PARTIES=
# CLERK_AUDIENCE=

# ---- Worker and artifact storage ----
REDIS_URL=redis://127.0.0.1:6379/0
S3_BUCKET=stock-agents
S3_ENDPOINT=http://127.0.0.1:9002
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9002
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Set false to reconcile queued jobs without scheduled vendor requests.
# SCHEDULER_RUN_MARKET_JOBS=false

# ---- Observability ----
# OTLP/HTTP base URI or an explicit /v1/traces endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# METRICS_BEARER_TOKEN=

# ---- Angel One scheduled NSE quotes (server-side SmartAPI credentials) ----
# Use angel_one with scripts/install_angel_market_task.ps1, or eodhd for the legacy EOD feed.
MARKET_PRICE_PROVIDER=angel_one
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PIN=
ANGEL_ONE_TOTP_SECRET=

# ---- EODHD (prices, corporate actions, news, fundamentals fallback) ----
EODHD_API_KEY=

# ---- FactSet (fundamentals, estimates, ownership, prices cross-check) ----
# Either serial + API key, OR a path to the OAuth JSON config file.
FACTSET_USERNAME_SERIAL=
FACTSET_API_KEY=
FACTSET_OAUTH_CONFIG=

# ---- FRED (risk-free rate, VIX) ----
FRED_API_KEY=

# ---- Alpaca (paper trading) ----
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ---- Optional: Reddit social buzz ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=stock-agents/0.1

# ---- Optional: alerting ----
SLACK_WEBHOOK_URL=
ALERT_EMAIL=
# Warm shared market snapshots after API startup and refresh them in the background.
PRELOAD_MARKET_DATA=true
